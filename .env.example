# ===========================================
# STUDYSIMPLE - Variabili d'Ambiente
# ===========================================

# DATABASE (Supabase - GRATIS)
# 1. Vai su https://supabase.com e crea un progetto
# 2. Clicca "Connect" → Connection string → URI
# 3. Sostituisci [YOUR-PASSWORD] con la tua password
DATABASE_URL="postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres"

# AUTENTICAZIONE
# Genera una chiave segreta su: https://generate-secret.vercel.app/32
AUTH_SECRET="genera-una-chiave-segreta-qui"
AUTH_URL="http://localhost:3000"

# Google OAuth (opzionale - per login con Google)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# HUGGING FACE (GRATIS!)
# 1. Vai su https://huggingface.co/settings/tokens
# 2. Crea un nuovo token
# 3. Copia la chiave qui sotto
HUGGINGFACE_API_KEY="hf_xxxxxxxxxxxxx"
